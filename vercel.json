{
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build && node -e \"const fs=require('fs');if(fs.existsSync('dist')){fs.cpSync('dist','../dist',{recursive:true})}\"",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
