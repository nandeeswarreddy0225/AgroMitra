{
  "name": "agromitra",
  "version": "2.0.0",
  "description": "AgroMitra — Intelligent Indian Agriculture Platform connecting Farmers, Agri Store Partners and Delivery Partners.",
  "private": true,
  "scripts": {
    "dev:backend": "node -e \"const cp=require('child_process');process.chdir('backend');cp.execSync('npm run dev',{stdio:'inherit'});\"",
    "dev:frontend": "node -e \"const cp=require('child_process');process.chdir('frontend');cp.execSync('npm run dev',{stdio:'inherit'});\"",
    "build:backend": "node -e \"const cp=require('child_process');process.chdir('backend');cp.execSync('npm install && npm run build',{stdio:'inherit'});\"",
    "build:frontend": "node -e \"const cp=require('child_process'),fs=require('fs');process.chdir('frontend');cp.execSync('npm install && npm run build',{stdio:'inherit'});if(fs.existsSync('dist')){fs.cpSync('dist','../dist',{recursive:true});}\"",
    "build": "node -e \"const cp=require('child_process'),fs=require('fs');process.chdir('frontend');cp.execSync('npm install && npm run build',{stdio:'inherit'});if(fs.existsSync('dist')){fs.cpSync('dist','../dist',{recursive:true});}\"",
    "test:backend": "node -e \"const cp=require('child_process');process.chdir('backend');cp.execSync('npm test',{stdio:'inherit'});\""
  },
  "keywords": [
    "agriculture",
    "agromitra",
    "farming",
    "ai-leaf-scanner",
    "mandi-prices",
    "direct-upi-qr",
    "crop-doctor",
    "delivery-partner",
    "agri-store-partner"
  ],
  "author": "AgroMitra Team",
  "license": "ISC"
}
