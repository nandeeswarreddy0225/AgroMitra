# =============================================================================
# AgroMitra — Unified Environment Configuration Template
# =============================================================================
# DO NOT COMMIT ACTUAL '.env' FILES TO GIT!
# Copy this file or individual service templates to .env in each directory:
#   backend/.env
#   frontend/.env
#   ai-service/.env

# -----------------------------------------------------------------------------
# 1. BACKEND SERVICE (Node.js / Express / TypeScript — Port 5000)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agrimart?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Initial System Administrator Credentials
ADMIN_PASSWORD=your_secure_admin_password_here


# AI Microservice URL (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Razorpay Online Payment Gateway (Optional / Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# -----------------------------------------------------------------------------
# 2. FRONTEND APPLICATION (Vite / React / TypeScript — Port 5173)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# -----------------------------------------------------------------------------
# 3. AI DIAGNOSTICS SERVICE (Python / FastAPI — Port 8000)
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
AI_MODEL_PATH=models/plant_disease_model.h5
